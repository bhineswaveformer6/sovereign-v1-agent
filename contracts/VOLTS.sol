pragma solidity ^0.8.26;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Burnable.sol";
import "@openzeppelin/contracts/access/AccessControl.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import "@openzeppelin/contracts/token/ERC721/extensions/ERC721URIStorage.sol";
import "@openzeppelin/contracts/token/common/ERC2981.sol";
import "@openzeppelin/contracts/utils/Strings.sol";
import "@openzeppelin/contracts/utils/cryptography/MerkleProof.sol";

interface IVOLTS {
    function mint(address to, uint256 amount, uint8 assetClass, bytes32 sourceId, string calldata formula) external;
        function oracleBurn(address from, uint256 amount) external;
        }

        contract VOLTS is ERC20, ERC20Burnable, AccessControl {
            bytes32 public constant MINTER_ROLE = keccak256("MINTER_ROLE");
                bytes32 public constant ORACLE_ROLE = keccak256("ORACLE_ROLE");
                    uint256 public constant INITIAL_DAILY_CAP = 10_000 * 10 ** 18;
                        uint256 public constant HALVING_INTERVAL_DAYS = 180;
                            uint256 public immutable genesisTimestamp;
                                mapping(uint256 => uint256) public mintedPerDay;

                                    enum AssetClass { CLASS0, CLASS1, CLASS2, CLASS3, CLASS4, CLASS5, CLASS6, CLASS7, CLASS8, CLASS9, CLASS10, CLASS11 }

                                        event VoltsMinted(address indexed to, uint256 amount, uint8 indexed assetClass, bytes32 indexed sourceId, string formula, uint256 unixDay);
                                            event OracleBurn(address indexed from, uint256 amount);

                                                error InvalidAssetClass();
                                                    error DailyCapExceeded(uint256 unixDay, uint256 cap, uint256 mintedSoFar, uint256 requested);

                                                        constructo
                                                                require(admin != address(0), "admin=0");
                                                                        genesisTimestamp = block.timestamp;
                                                                                _grantRole(DEFAULT_ADMIN_ROLE, admin);
                                                                                        _grantRole(MINTER_ROLE, admin);
                                                                                                _grantRole(ORACLE_ROLE, admin);
                                                                                                    }
                                                                                                    
                                                                                                        function currentUnixDay() public view returns (uint256) { return block.timestamp / 1 days; }
                                                                                                        
                                                                                                            function halvingCount() public view returns (uint256) {
                                                                                                                    uint256 daysElapsed = (block.timestamp - genesisTimestamp) / 1 days;
                                                                                                                            return daysElapsed / HALVING_INTERVAL_DAYS;
                                                                                                                                }
                                                                                                                                
                                                                                                                                    function dailyCapForTimestamp(uint256 timestamp) public view returns (uint256) {
                                                                                                                                            if (timestamp < genesisTimestamp) return INITIAL_DAILY_CAP;
                                                                                                                                                    uint256 daysElapsed = (timestamp - genesisTimestamp) / 1 days;
                                                                                                                                                            uint256 halvings = daysElapsed / HALVING_INTERVAL_DAYS;
                                                                                                                                                                    if (halvings >= 256) return 0;
                                                                                                                                                                            return INITIAL_DAILY_CAP >> halvings;
                                                                                                                                                                                }
                                                                                                                                                                                
                                                                                                                                                                                    function currentDailyCap() public view returns (uint256) { return dailyCapForTimestamp(block.timestamp); }
                                                                                                                                                                                    
                                                                                                                                                                                        function mint(address to, uint256 amount, uint8 assetClass, bytes32 sourceId, string calldata formula) external onlyRole(MINTER_ROLE) {
                                                                                                                                                                                                if (assetClass > uint8(type(AssetClass).max)) revert InvalidAssetClass();
                                                                                                                                                                                                        require(to != address(0), "to=0");
                                                                                                                                                                                                                require(amount > 0, "amount=0");
                                                                                                                                                                                                                        uint256 day = currentUnixDay();
                                                                                                                                                                                                                                uint256 cap = currentDailyCap();
                                                                                                                                                                                                                                        uint256 mintedSoFar = mintedPerDay[day];
                                                                                                                                                                                                                                                if (mintedSoFar + amount > cap) revert DailyCapExceeded(day, cap, mintedSoFar, amount);
                                                                                                                                                                                                                                                        mintedPerDay[day] = mintedSoFar + amount;
                                                                                                                                                                                                                                                                _mint(to, amount);
                                                                                                                                                                                                                                                                        emit VoltsMinted(to, amount, assetClass, sourceId, formula, day);
                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                function oracleBurn(address from, uint256 amount) external onlyRole(ORACLE_ROLE) {
                                                                                                                                                                                                                                                                                        require(from != address(0), "from=0");
                                                                                                                                                                                                                                                                                                require(amount > 0, "amount=0");
                                                                                                                                                                                                                                                                                                        _burn(from, amount);
                                                                                                                                                                                                                                                                                                                emit OracleBurn(from, amount);
                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                        function supportsInterface(bytes4 interfaceId) public view virtual override(AccessControl) returns (bool) {
                                                                                                                                                                                                                                                                                                                                return super.supportsInterface(interfaceId);
                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                    contract VOLTSStaking is AccessControl, ReentrancyGuard {
                                                                                                                                                                                                                                                                                                                                        using SafeERC20 for IERC20;
                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                            bytes32 public constant ORACLE_ROLE = keccak256("ORACLE_ROLE");
                                                                                                                                                                                                                                                                                                                                                uint256 public constant MIN_LOCK_DURATION = 7 days;
                                                                                                                                                                                                                                                                                                                                                    uint256 public constant SUCCESS_YIELD_BPS = 2000;
                                                                                                                                                                                                                                                                                                                                                        uint256 public constant FAILURE_SLASH_BPS = 5000;
                                                                                                                                                                                                                                                                                                                                                            uint256 public constant BPS_DENOMINATOR = 10_000;
                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                IVOLTS public immutable volts;
                                                                                                                                                                                                                                                                                                                                                                    IERC20 public immutable voltsErc20;
                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                        enum StakeStatus { None, Active, Resolved }
                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                            struct Stake {
                                                                                                                                                                                                                                                                                                                                                                                    address staker;
                                                                                                                                                                                                                                                                                                                                                                                            uint256 amount;
                                                                                                                                                                                                                                                                                                                                                                                                    uint256 startTime;
                                                                                                                                                                                                                                                                                                                                                                                                            uint256 unlockTime;
                                                                                                                                                                                                                                                                                                                                                                                                                    StakeStatus status;
                                                                                                                                                                                                                                                                                                                                                                                                                            bool success;
                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 payoutToStaker;
                                                                                                                                                                                                                                                                                                                                                                                                                                            uint256 slashedAmount;
                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 public nextStakeId;
                                                                                                                                                                                                                                                                                                                                                                                                                                                        mapping(uint256 => Stake) public stakes;
                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                            event Staked(uint256 indexed stakeId, address indexed staker, uint256 amount, uint256 startTime, uint256 unlockTime);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                event StakeResolved(uint256 indexed stakeId, address indexed staker, bool success, uint256 principal, uint256 yieldAmount, uint256 payoutToStaker, uint256 slashedAmount);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    error StakeNotActive(uint256 stakeId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        error StakeLocked(uint256 stakeId, uint256 unlockTime, uint256 nowTime);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                            error AmountZero();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                error TransferFailed();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    constructo
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(admin != address(0), "admin=0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    require(address(voltsToken) != address(0), "volts=0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            volts = voltsToken;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    voltsErc20 = IERC20(address(voltsToken));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            _grantRole(DEFAULT_ADMIN_ROLE, admin);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    _grantRole(ORACLE_ROLE, admin);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            nextStakeId = 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    function stake(uint256 amount) external nonReentrant returns (uint256 stakeId) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (amount == 0) revert AmountZero();
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 startTime = block.timestamp;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            uint256 unlockTime = startTime + MIN_LOCK_DURATION;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    stakeId = nextStakeId++;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            stakes[stakeId] = Stake({ staker: msg.sender, amount: amount, startTime: startTime, unlockTime: unlockTime, status: StakeStatus.Active, success: false, payoutToStaker: 0, slashedAmount: 0 });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    voltsErc20.safeTransferFrom(msg.sender, address(this), amount);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            emit Staked(stakeId, msg.sender, amount, startTime, unlockTime);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    function resolveStake(uint256 stakeId, bool success) external onlyRole(ORACLE_ROLE) nonReentrant {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            Stake storage s = stakes[stakeId];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (s.status != StakeStatus.Active) revert StakeNotActive(stakeId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (block.timestamp < s.unlockTime) revert StakeLocked(stakeId, s.unlockTime, block.timestamp);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    s.status = StakeStatus.Resolved;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            s.success = success;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 principal = s.amount;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (success) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        uint256 yieldAmount = (principal * SUCCESS_YIELD_BPS) / BPS_DENOMINATOR;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 payout = principal + yieldAmount;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (yieldAmount > 0) volts.mint(address(this), yieldAmount, 0, bytes32(uint256(stakeId)), "staking:success_yield");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            s.payoutToStaker = payout;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        s.slashedAmount = 0;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    voltsErc20.safeTransfer(s.staker, payout);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                emit StakeResolved(stakeId, s.staker, true, principal, yieldAmount, payout, 0);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 slashed = (principal * FAILURE_SLASH_BPS) / BPS_DENOMINATOR;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                uint256 returned = principal - slashed;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            s.payoutToStaker = returned;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        s.slashedAmount = slashed;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (returned > 0) voltsErc20.safeTransfer(s.staker, returned);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (slashed > 0) volts.oracleBurn(address(this), slashed);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            emit StakeResolved(stakeId, s.staker, false, principal, 0, returned, slashed);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function supportsInterface(bytes4 interfaceId) public view virtual override(AccessControl) returns (bool) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return super.supportsInterface(interfaceId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        contract SovereignObjects is ERC721URIStorage, ERC2981, AccessControl {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            bytes32 public constant MINTER_ROLE = keccak256("MINTER_ROLE");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                struct ObjectMetadata {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        string title;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                string category;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        uint256 voltsValue;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                address creator;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        uint256 mintTimestamp;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                bytes32 merkleRoot;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        uint256 private _nextTokenId;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            mapping(uint256 => ObjectMetadata) public metadataOf;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                event SovereignObjectMinted(uint256 indexed tokenId, address indexed recipient, address indexed creator, string title, string category, uint256 voltsValue, bytes32 merkleRoot);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    constructo
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(admin != address(0), "admin=0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    _grantRole(DEFAULT_ADMIN_ROLE, admin);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            _grantRole(MINTER_ROLE, admin);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    _nextTokenId = 1;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function mintSovereignObject(address to, string calldata tokenURI_, string calldata title, string calldata category, uint256 voltsValue, bytes32 merkleRoot) external onlyRole(MINTER_ROLE) returns (uint256 tokenId) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    require(to != address(0), "to=0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            tokenId = _nextTokenId++;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    _safeMint(to, tokenId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            _setTokenURI(tokenId, tokenURI_);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    metadataOf[tokenId] = ObjectMetadata({ title: title, category: category, voltsValue: voltsValue, creator: to, mintTimestamp: block.timestamp, merkleRoot: merkleRoot });
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            _setTokenRoyalty(tokenId, to, 500);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    emit SovereignObjectMinted(tokenId, to, to, title, category, voltsValue, merkleRoot);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function supportsInterface(bytes4 interfaceId) public view virtual override(ERC721URIStorage, ERC2981, AccessControl) returns (bool) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return super.supportsInterface(interfaceId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            function tokenURI(uint256 tokenId) public view virtual override(ERC721URIStorage) returns (string memory) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return super.tokenURI(tokenId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        contract MerkleProvenanceRegistry is AccessControl {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            using MerkleProof for bytes32[];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                bytes32 public constant PUBLISHER_ROLE = keccak256("PUBLISHER_ROLE");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    struct WeeklyRoot {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            bytes32 root;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 timestamp;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            uint256 totalVOLTS;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    uint256 activeUsers;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            WeeklyRoot[] private _weeklyRoots;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                event ProvenanceRootPublished(uint256 indexed weekIndex, bytes32 indexed root, uint256 totalVOLTS, uint256 activeUsers);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    constructo
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            require(admin != address(0), "admin=0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    _grantRole(DEFAULT_ADMIN_ROLE, admin);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            _grantRole(PUBLISHER_ROLE, admin);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    function weeklyRootsCount() external view returns (uint256) { return _weeklyRoots.length; }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        function getWeeklyRoot(uint256 weekIndex) external view returns (WeeklyRoot memory) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                require(weekIndex < _weeklyRoots.length, "weekIndex OOB");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return _weeklyRoots[weekIndex];
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function publishRoot(bytes32 root, uint256 totalVOLTS, uint256 activeUsers) external onlyRole(PUBLISHER_ROLE) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        require(root != bytes32(0), "root=0");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                _weeklyRoots.push(WeeklyRoot({ root: root, timestamp: block.timestamp, totalVOLTS: totalVOLTS, activeUsers: activeUsers }));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        emit ProvenanceRootPublished(_weeklyRoots.length - 1, root, totalVOLTS, activeUsers);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function verifyProof(uint256 weekIndex, address user, uint256 balance, bytes32[] calldata proof) external view returns (bool) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        require(weekIndex < _weeklyRoots.length, "weekIndex OOB");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                bytes32 leaf = keccak256(abi.encodePacked(user, balance));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return MerkleProof.verify(proof, _weeklyRoots[weekIndex].root, leaf);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                function supportsInterface(bytes4 interfaceId) public view virtual override(AccessControl) returns (bool) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return super.supportsInterface(interfaceId);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
